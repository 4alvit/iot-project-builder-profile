# Logs - NEVER push to GitHub
logs/
*.log

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
uv.lock

# OS
.DS_Store

# Coverage
.coverage
htmlcov/
.mypy_cache/
# Local env (real gateway credentials) - never push
.env

# Runtime-generated jinja templates (recreated from renderer.py defaults)
iot_profile_builder/output/templates/
*.backup

# Local CI/release artifacts
release-dist/
.release-download/
.release-assets/
.release-evidence/

# The CI lockfile is part of the reproducible build contract.
!uv.lock

# Local CI coverage output
coverage.xml

# Isolated RC fuzz runtime and local diagnostic inputs
.fuzz-venv/
crash-*
timeout-*
oom-*

# Frozen release overlays and staged receipts are local build outputs
.release-plan.json
.release-inputs.json
release-assets/
native-inputs/
native-output/
