{
  "schema": 1,
  "repository": "4alvit/iot-project-builder-profile",
  "mode": "release",
  "default_branch": "main",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml",
    "release-security.yml",
    "dependency-review.yml"
  ],
  "artifact_pattern": "release-assets*",
  "version_file": "pyproject.toml",
  "local_checks": [
    "bash scripts/ci.sh",
    "bash scripts/ci.sh security"
  ],
  "notes": [
    "Offline application tests cover public repository scanning, ESPHome/D-Bus analysis, profile generation and JSON/HTML/Markdown outputs; required CI enforces 65% application coverage."
  ],
  "container_assets": {},
  "visibility": "public",
  "single_entry_ci": true,
  "release_notes": "CHANGELOG.md",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "pyproject.toml",
        "format": "toml",
        "field": "project.version",
        "package": "iot-profile-builder",
        "value": "package",
        "ecosystem": "pep440"
      },
      {
        "path": "uv.lock",
        "format": "uv-lock",
        "package": "iot-profile-builder",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "artifacts": [
      {
        "path": "iot-project-builder-profile-*.tar.gz",
        "format": "tar-toml",
        "member": "iot-project-builder-profile/pyproject.toml",
        "field": "project.version",
        "package": "iot-profile-builder",
        "value": "package",
        "ecosystem": "pep440"
      }
    ],
    "toolkit_revision": "5e413f80a4353d328b4529eae57992ac3987e2dd"
  },
  "fuzzing": {
    "toolkit_ref": "4b91853946612822e5c2876d211bdbf5f35aa69c"
  }
}
