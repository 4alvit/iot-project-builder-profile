# LLM backend for iot-profile-builder (ProfileGenerator uses the Anthropic SDK,
# which reads both variables from the environment).
#
# Point it at the self-hosted Free Claude Code (FCC) proxy deployed in the
# energy-data-rag-pipeline stack on the Synology NAS (fcc service, host
# networking, port 8082). Any model id is accepted — the gateway routes every
# request to its single configured provider model, so "default" works.
#
# Usage: cp .env.sample .env && set -a && source .env && set +a
#        iot-profile-builder <username> [--model default]
#
ANTHROPIC_BASE_URL=http://synology:8082

# Access password for the proxy (FCC's ANTHROPIC_AUTH_TOKEN, default "freecc"
# when PROXY_AUTH_ENABLED=false). Required by the SDK even when the gateway
# does not enforce it.
ANTHROPIC_API_KEY=freecc

# Unset to use the public Anthropic API instead of the gateway.
